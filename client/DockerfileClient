ARG NODE_VERSION=22.14.0

FROM node:${NODE_VERSION}-alpine

WORKDIR /app/packages/pricing

COPY packages/pricing/package*.json ./

RUN npm install

COPY packages/pricing .

RUN npm run build

WORKDIR /app/client

COPY client/package*.json ./

RUN npm install

COPY client .

ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

EXPOSE 5173

CMD ["npm", "run", "dev"]
