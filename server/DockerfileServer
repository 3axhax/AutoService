ARG NODE_VERSION=22.14.0

FROM node:${NODE_VERSION}-alpine

WORKDIR /app/packages/pricing

COPY packages/pricing/package*.json ./

RUN npm install

COPY packages/pricing .

RUN npm run build

WORKDIR /app/server

COPY server/package*.json ./

RUN npm install

COPY server .

CMD ["npm", "run", "start:dev"]
