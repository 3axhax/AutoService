ARG NODE_VERSION=22.14.0
FROM node:${NODE_VERSION}-alpine AS dependencies
WORKDIR /app/packages/pricing
COPY packages/pricing/package*.json ./
RUN npm ci
COPY packages/pricing/tsconfig.json ./
COPY packages/pricing/src ./src
RUN npm run build

WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci

FROM dependencies AS development
COPY server .
EXPOSE 5050
CMD ["npm", "run", "start:dev"]

FROM development AS build
RUN npm run build
RUN npm prune --omit=dev

FROM node:${NODE_VERSION}-alpine AS production
ENV NODE_ENV=production
ENV PORT=5050
WORKDIR /app/server
COPY --from=build --chown=node:node /app/server/dist ./dist
COPY --from=build --chown=node:node /app/server/node_modules ./node_modules
COPY --from=build --chown=node:node /app/server/package*.json ./
COPY --from=build --chown=node:node /app/packages/pricing/package.json /app/packages/pricing/package.json
COPY --from=build --chown=node:node /app/packages/pricing/dist /app/packages/pricing/dist
USER node
EXPOSE 5050
CMD ["node", "dist/main.js"]
